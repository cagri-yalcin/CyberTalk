rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn()
        && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'admin';
    }

    function conversationParticipant(
      conversationId
    ) {
      return signedIn()
        && request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(conversationId)
        ).data.participants;
    }

    function conversationParticipantAfter(
      conversationId
    ) {
      return signedIn()
        && request.auth.uid in getAfter(
          /databases/$(database)/documents/conversations/$(conversationId)
        ).data.participants;
    }

    match /users/{userId} {
      allow read: if signedIn();

      allow create: if isOwner(userId)
        && request.resource.data.role == 'user';

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && request.resource.data.role ==
             resource.data.role
        );

      allow delete: if false;
    }

    match /usernames/{username} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.uid ==
           request.auth.uid;

      allow update: if signedIn()
        && resource.data.uid ==
           request.auth.uid
        && request.resource.data.uid ==
           request.auth.uid;

      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn()
        && request.auth.uid in
           resource.data.participants;

      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in
           request.resource.data.participants;

      allow update: if signedIn()
        && request.auth.uid in
           resource.data.participants
        && request.resource.data.participants is list
        && request.auth.uid in
           request.resource.data.participants;

      allow delete: if false;
    }

    match /messages/{messageId} {

      /*
       * Mesajları sadece bağlı oldukları
       * sohbetin katılımcıları okuyabilir.
       *
       * Bu özellikle Conversation.js içindeki:
       *
       * messages
       *   .where('conversationId', '==', conversationId)
       *
       * sorgusunun realtime çalışması için kullanılır.
       */
      allow read: if signedIn()
        && conversationParticipant(
          resource.data.conversationId
        );

      /*
       * Yeni mesaj:
       *
       * - mesajı oluşturan kullanıcı giriş yapmış olmalı
       * - uid kendi UID'si olmalı
       * - senderId kendi UID'si olmalı
       * - receiverId string olmalı
       * - conversationId string olmalı
       * - kullanıcı mevcut sohbetin katılımcısı olmalı
       *
       * Yeni sohbet oluşturulurken aynı batch
       * içerisinde conversation oluşturuluyorsa
       * conversationParticipantAfter() da kabul edilir.
       */
      allow create: if signedIn()
        && request.resource.data.uid ==
           request.auth.uid
        && request.resource.data.senderId ==
           request.auth.uid
        && request.resource.data.receiverId is string
        && request.resource.data.conversationId is string
        && (
          conversationParticipant(
            request.resource.data.conversationId
          )
          ||
          conversationParticipantAfter(
            request.resource.data.conversationId
          )
        );

      /*
       * Mesaj sahibi:
       * herkesten silme alanlarını değiştirebilir.
       *
       * Sohbet katılımcısı:
       * kendi reaction alanını değiştirebilir.
       */
      allow update: if signedIn()
        && (
          (
            resource.data.senderId ==
              request.auth.uid

            && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'deletedForEveryone',
                'deletedAt'
              ])
          )

          ||

          (
            conversationParticipant(
              resource.data.conversationId
            )

            && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'reactions'
              ])

            && request.resource.data
              .get('reactions', {})
              .diff(
                resource.data
                  .get('reactions', {})
              )
              .affectedKeys()
              .hasOnly([
                request.auth.uid
              ])
          )
        );

      allow delete: if false;
    }

    /*
     * "Benden sil" kayıtları.
     */
    match /messageDeletions/{deletionId} {

      allow read: if signedIn()
        && resource.data.uid ==
           request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.uid ==
           request.auth.uid
        && request.resource.data.messageId is string
        && request.resource.data.conversationId is string;

      allow delete: if signedIn()
        && resource.data.uid ==
           request.auth.uid;

      allow update: if false;
    }

    match /adminData/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}