rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn()
        && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'admin';
    }

    function conversationParticipant(
      conversationId
    ) {
      return signedIn()
        && request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(conversationId)
        ).data.participants;
    }

    function conversationParticipantAfter(
      conversationId
    ) {
      return signedIn()
        && request.auth.uid in getAfter(
          /databases/$(database)/documents/conversations/$(conversationId)
        ).data.participants;
    }

    match /users/{userId} {
      allow read: if signedIn();

      allow create: if isOwner(userId)
        && request.resource.data.role == 'user';

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && request.resource.data.role ==
             resource.data.role
        );

      allow delete: if false;
    }

    match /usernames/{username} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.uid ==
           request.auth.uid;

      allow update: if signedIn()
        && resource.data.uid ==
           request.auth.uid
        && request.resource.data.uid ==
           request.auth.uid;

      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn()
        && request.auth.uid in
           resource.data.participants;

      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in
           request.resource.data.participants;

      allow update: if signedIn()
        && request.auth.uid in
           resource.data.participants
        && request.resource.data.participants is list
        && request.auth.uid in
           request.resource.data.participants;

      allow delete: if false;
    }

    match /messages/{messageId} {

      /*
       * Mesajları sadece bağlı oldukları
       * sohbetin katılımcıları okuyabilir.
       */
      allow read: if signedIn()
        && conversationParticipant(
          resource.data.conversationId
        );

      /*
       * Yeni mesaj oluşturma.
       */
      allow create: if signedIn()
        && request.resource.data.uid ==
           request.auth.uid
        && request.resource.data.senderId ==
           request.auth.uid
        && request.resource.data.receiverId is string
        && request.resource.data.conversationId is string
        && (
          conversationParticipant(
            request.resource.data.conversationId
          )
          ||
          conversationParticipantAfter(
            request.resource.data.conversationId
          )
        );

      /*
       * Mesaj güncellemeleri.
       */
      allow update: if signedIn()
        && (

          /*
           * Herkesten silme.
           */
          (
            resource.data.senderId ==
              request.auth.uid

            && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'deletedForEveryone',
                'deletedAt'
              ])
          )

          ||

          /*
           * Mesaj düzenleme.
           */
          (
            resource.data.senderId ==
              request.auth.uid

            && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'text',
                'editedAt'
              ])

            && request.resource.data.text is string
            && request.resource.data.editedAt is timestamp
            && (
              resource.data.type == 'text'
              || resource.data.type == 'image'
              || resource.data.type == 'file'
            )
          )

          ||

          /*
           * Reaction güncelleme.
           */
          (
            conversationParticipant(
              resource.data.conversationId
            )

            && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'reactions'
              ])

            && request.resource.data
              .get('reactions', {})
              .diff(
                resource.data
                  .get('reactions', {})
              )
              .affectedKeys()
              .hasOnly([
                request.auth.uid
              ])
          )

          ||

          /*
           * Teslim edildi bilgisi.
           *
           * Mesaj sahibi kendi mesajına,
           * alıcının UID'sini deliveredTo listesine
           * ekleyebilir.
           */
          (
            resource.data.senderId ==
              request.auth.uid

            && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'deliveredTo'
              ])

            && request.resource.data
              .get('deliveredTo', [])
              is list

            && resource.data
              .get('deliveredTo', [])
              is list

            && request.resource.data
              .get('deliveredTo', [])
              .hasAll(
                resource.data
                  .get('deliveredTo', [])
              )

            && request.resource.data
              .get('deliveredTo', [])
              .size()
              ==
              resource.data
                .get('deliveredTo', [])
                .size()
              + 1

            && request.resource.data
              .get('deliveredTo', [])
              .hasAny([
                resource.data.receiverId
              ])
          )

          )
          ||

          /*
           * Teslim edildi bilgisi:
           * Mesaj sahibi, kendi mesajına
           * alıcının UID'sini deliveredTo listesine
           * ekleyebilir.
           */
          (
            resource.data.senderId ==
              request.auth.uid

            && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'deliveredTo'
              ])

            && request.resource.data
              .get('deliveredTo', [])
              is list

            && resource.data
              .get('deliveredTo', [])
              is list

            && request.resource.data
              .get('deliveredTo', [])
              .hasAll(
                resource.data
                  .get('deliveredTo', [])
              )

            && request.resource.data
              .get('deliveredTo', [])
              .size()
              ==
              resource.data
                .get('deliveredTo', [])
                .size()
              + 1

            && request.resource.data
              .get('deliveredTo', [])
              .hasAny([
                resource.data.receiverId
              ])
          )

          ||
          

          /*
           * Okundu bilgisi:
           *
           * Sohbet katılımcısı sadece kendi UID'sini
           * readBy listesine ekleyebilir.
           */
          (
            conversationParticipant(
              resource.data.conversationId
            )

            && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'readBy'
              ])

            && request.resource.data
              .get('readBy', [])
              is list

            && resource.data
              .get('readBy', [])
              is list

            && request.resource.data
              .get('readBy', [])
              .hasAll(
                resource.data
                  .get('readBy', [])
              )

            && request.resource.data
              .get('readBy', [])
              .size()
              ==
              resource.data
                .get('readBy', [])
                .size()
              + 1

            && request.auth.uid in
              request.resource.data
                .get('readBy', [])
          )
        

      allow delete: if false;
    }

    /*
     * "Benden sil" kayıtları.
     */
    match /messageDeletions/{deletionId} {

      allow read: if signedIn()
        && resource.data.uid ==
           request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.uid ==
           request.auth.uid
        && request.resource.data.messageId is string
        && request.resource.data.conversationId is string;

      allow delete: if signedIn()
        && resource.data.uid ==
           request.auth.uid;

      allow update: if false;
    }

    match /adminData/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}